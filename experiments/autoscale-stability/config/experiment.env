# Konfigurasi eksperimen Online Boutique: stabilitas throughput saat autoscale.
# Variabel yang sudah di-export oleh pemanggil selalu menang atas nilai di sini,
# contoh: REPLICATE=2 HPA_MAX=8 ./scripts/run-experiment.sh scenarios/step.env cpu

# IP mesin yang menjalankan kind (port 80 ingress). WAJIB diganti di mesin lain.
HOST_IP=192.168.18.60
NAMESPACE=boutique
TARGET_URL=http://boutique.${HOST_IP}.sslip.io
PROMETHEUS_URL=http://prometheus.${HOST_IP}.sslip.io

# Collector Pak Roy (cloud-dynamics-metrics) dipakai ulang
CLOUD2023_RESEARCH=${HOME}/cloud2023/kubernetes/research

# Load generator: locustfile bawaan repo ini (src/loadgenerator)
LOCUSTFILE=${ROOT}/../../src/loadgenerator/locustfile.py
SPAWN_RATE=10
WARMUP_SECONDS=60
WARMUP_USERS=10
COOLDOWN_SECONDS=60

# Step query Prometheus (detik), sama dengan resolusi workload.csv
SAMPLE_INTERVAL=1

# Deployment yang di-autoscale (jalur utama request dari frontend)
SCALE_TARGETS="frontend productcatalogservice currencyservice recommendationservice cartservice checkoutservice"
# Mode "none": jumlah replika tetap
FIXED_REPLICAS=1
# Mode "cpu" / "memory": parameter HPA (autoscaling/v2, ContainerResource container "server")
HPA_MIN=1
HPA_MAX=5
HPA_CPU_UTILIZATION=50
HPA_MEMORY_UTILIZATION=70
# Default Kubernetes 300 s; dipendekkan agar scale-in terlihat dalam satu run
HPA_SCALE_DOWN_WINDOW=60
# Jeda setelah reset replika + pasang HPA, sebelum warm-up
SETTLE_SECONDS=90

# Jalankan collector otomatis setelah cool-down (1 = ya)
AUTO_COLLECT=1
# Detik awal tiap stage yang dibuang saat menghitung CV per stage (masa transisi)
STAGE_TRIM_SECONDS=30

REPLICATE=1
