# PromQL untuk collector Pak Roy (collect.py). __NAMESPACE__ = boutique, __APP__ = frontend.
# Nama berakhiran _BY_<label> menghasilkan satu deret per deployment/app: di combined.csv
# nilainya dirata-rata oleh collect.py (tidak bermakna), gunakan timeline.csv (pivot_series.py).
#
# Jendela rate: metrik Linkerd di-scrape tiap 5 s -> [30s]; cAdvisor/kube-state-metrics tiap 30 s -> [1m].

# Frontend = pintu masuk; throughput sisi server diukur oleh linkerd-proxy
FRONTEND_RPS=sum(rate(request_total{namespace="__NAMESPACE__",direction="inbound",app=~"__APP__",srv_port!="4191"}[30s]))
FRONTEND_SUCCESS_RATE=sum(rate(response_total{namespace="__NAMESPACE__",direction="inbound",app=~"__APP__",srv_port!="4191",classification="success"}[30s])) / sum(rate(response_total{namespace="__NAMESPACE__",direction="inbound",app=~"__APP__",srv_port!="4191"}[30s]))
FRONTEND_LATENCY_P95=histogram_quantile(0.95, sum by (le) (rate(response_latency_ms_bucket{namespace="__NAMESPACE__",direction="inbound",app=~"__APP__",srv_port!="4191"}[30s])))
FRONTEND_REPLICAS=sum(kube_deployment_status_replicas_available{namespace="__NAMESPACE__",deployment=~"__APP__"})
FRONTEND_CPU_PER_POD=avg(rate(container_cpu_usage_seconds_total{namespace="__NAMESPACE__",pod=~"__APP__-.+",container="server"}[1m]))
FRONTEND_CPU_THROTTLED=sum(rate(container_cpu_cfs_throttled_seconds_total{namespace="__NAMESPACE__",pod=~"__APP__-.+",container="server"}[1m]))
TOTAL_READY_PODS=sum(kube_deployment_status_replicas_available{namespace="__NAMESPACE__"})

# Per deployment / app
REPLICAS_BY_DEPLOY=sum by (deployment) (kube_deployment_status_replicas_available{namespace="__NAMESPACE__"})
HPA_DESIRED_BY_HPA=sum by (horizontalpodautoscaler) (kube_horizontalpodautoscaler_status_desired_replicas{namespace="__NAMESPACE__"})
RPS_BY_APP=sum by (app) (rate(request_total{namespace="__NAMESPACE__",direction="inbound",srv_port!="4191"}[30s]))
P95_BY_APP=histogram_quantile(0.95, sum by (app, le) (rate(response_latency_ms_bucket{namespace="__NAMESPACE__",direction="inbound",srv_port!="4191"}[30s])))
CPU_BY_DEPLOY=sum by (deployment) (label_replace(rate(container_cpu_usage_seconds_total{namespace="__NAMESPACE__",container="server"}[1m]), "deployment", "$1", "pod", "(.+)-[a-z0-9]+-[a-z0-9]+"))
CPU_UTIL_BY_DEPLOY=sum by (deployment) (label_replace(rate(container_cpu_usage_seconds_total{namespace="__NAMESPACE__",container="server"}[1m]), "deployment", "$1", "pod", "(.+)-[a-z0-9]+-[a-z0-9]+")) / sum by (deployment) (label_replace(kube_pod_container_resource_requests{namespace="__NAMESPACE__",container="server",resource="cpu"}, "deployment", "$1", "pod", "(.+)-[a-z0-9]+-[a-z0-9]+"))
